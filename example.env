# ========================================================
# INFO-H420 Assignment 3: Environment Configuration Template
# ========================================================
#
# Instructions:
# 1. Copy this file to '.env':
# 2. Update the paths and values below according to your setup.
# ========================================================

# --------------------------------------------------------
# 1. Folders Configuration
# --------------------------------------------------------
# PAPERS_DIR:
PAPERS_DIR="/mnt/g/Mon Drive/ResearchLibrary/papers"

# OUTPUT_DIR:
OUTPUT_DIR="/mnt/g/Mon Drive/ResearchLibrary/output"

# DB_PATH:
DB_PATH=/mnt/c/Users/your_user/Info-h420-Assignement-3/data/papers.db

# TEMPLATE_PATH:
TEMPLATE_PATH=/mnt/c/Users/your_user/Info-h420-Assignement-3/templates/index.html

# --------------------------------------------------------
# 2. Local LLM Configuration (Ollama / LM Studio)
# --------------------------------------------------------
# LLM_API_BASE:
#   - Ollama default: http://localhost:11434/v1
LLM_API_BASE=http://localhost:11434/v1

# LLM_API_KEY:
LLM_API_KEY=ollama

# LLM_MODEL:
LLM_MODEL=llama3.2:1b

# --------------------------------------------------------
# 3. Notifications
# --------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
